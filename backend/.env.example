PORT=5000
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=your_better_auth_secret_here_min_32_chars
BETTER_AUTH_URL=https://brag-better-rag.vercel.app
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
LLM_PROVIDER=gemini # Supports: gemini, groq, openai, openrouter, cerebras, deepseek
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=your_openrouter_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MOCK_LLM=false
REPO_ROOT_PATH=.
GITHUB_MCP=your_github_token_here
CONTEXT7_MCP=your_context7_token_here
